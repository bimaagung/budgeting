{
  "name": "Daily Reminder → WhatsApp",
  "nodes": [
    {
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 20 * * *" }]
        }
      },
      "notes": "Berjalan setiap hari jam 20.00 WIB (13.00 UTC). Sesuaikan timezone di n8n settings."
    },
    {
      "name": "Daftar Nomor User",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "array": [
            { "name": "phones", "value": ["628xxxxxxxxxx", "628yyyyyyyyyy"] }
          ]
        }
      },
      "notes": "Hardcode nomor user untuk 2 user personal. Bisa diganti dengan query ke DB jika user bertambah."
    },
    {
      "name": "Loop per User",
      "type": "n8n-nodes-base.splitInBatches",
      "parameters": { "batchSize": 1 }
    },
    {
      "name": "GET Reminder dari Golang",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:8080/api/reminder/{{ $json.phone }}",
        "responseFormat": "json"
      }
    },
    {
      "name": "Kirim Reminder ke WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "headers": {
          "Authorization": "=Bearer {{ $env.WA_API_TOKEN }}"
        },
        "bodyParametersUi": {
          "parameter": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{ $node['Loop per User'].json.phone }}" },
            { "name": "type", "value": "text" },
            { "name": "text.body", "value": "={{ $json.message }}" }
          ]
        }
      }
    }
  ],
  "connections": {
    "Cron Trigger": { "main": [[ { "node": "Daftar Nomor User" } ]] },
    "Daftar Nomor User": { "main": [[ { "node": "Loop per User" } ]] },
    "Loop per User": { "main": [[ { "node": "GET Reminder dari Golang" } ]] },
    "GET Reminder dari Golang": { "main": [[ { "node": "Kirim Reminder ke WhatsApp" } ]] }
  }
}
